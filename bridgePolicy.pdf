    </div>
    <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=66c78bffc753432b33c4f61a" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
    <script src="https://cdn.prod.website-files.com/66c78bffc753432b33c4f61a/js/bridgexyz-site.schunk.59db69f9bc7a3df7.js" type="text/javascript" integrity="sha384-2K8YxxGhLOyQb6Mm5r5mz3J6GgNpUDWvD5eVfj02RfT9K5e2e/yfx+5/A8GeEBLR" crossorigin="anonymous"></script>
    <script src="https://cdn.prod.website-files.com/66c78bffc753432b33c4f61a/js/bridgexyz-site.schunk.889f0aba4a3d3992.js" type="text/javascript" integrity="sha384-4ervstgFDnhmju/Z/IkNe9yhh5p90Tg6yX+nnMjUE8a6F3pphtpMnD2woBjr/P/T" crossorigin="anonymous"></script>
    <script src="https://cdn.prod.website-files.com/66c78bffc753432b33c4f61a/js/bridgexyz-site.3fa6647c.e7e4eda7c8ab58ed.js" type="text/javascript" integrity="sha384-qpP6KWbws8VKyAlAELHWqE7lSP/riOjufIzrYnn67fK6FMTxybM4pb/YV9xuJD/3" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>

    <script>
      //Update current year on footer

      $('#current-year').text(new Date().getFullYear());

      //Newsletter Submit

      $('.newsletter-submit-button').on('click', function() {
        $('.form-submit').click();
      });

      //-------------Newsletter Email Validation-----------//

      // Get the input element and the submit button
      const emailInput = document.querySelector('#newsletter-mail-input');
      const submitButton = document.querySelector('.newsletter-submit-button');

      // Function to validate email
      function validateEmail(email) {
        const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        return re.test(email);
      }

      // Add an event listener for input changes
      if (emailInput) {
        emailInput.addEventListener('input', function() {
          if (validateEmail(this.value)) {
            submitButton.classList.add('active');
          } else {
            submitButton.classList.remove('active');
          }
        });
      }

      //----------------Navbar Animations on scroll---------------//

      // Get the navbar element
      const navbar = document.querySelector('.navbar');

      // Create a ScrollTrigger
      ScrollTrigger.create({
        // Start the effect when the scroll position is 5% from the top
        // Updated to fixed value 36px instead of 5% due bug on legal page (5% on legal page is too much scroll)
        start: "36px top",
        // Run this function every time the scroll position updates
        onUpdate: (self) => {
          // If we've scrolled past the start point, add the class

          if (self.progress > 0) {
            navbar.classList.add('scroll');
          } else {
            // Otherwise, remove the class
            navbar.classList.remove('scroll');
          }
        }
      });

      //-----------------Navbar Animation on Mobile-------------------//


      const menuButton = document.querySelector('.menu-button');

      if (menuButton) {
        menuButton.addEventListener('click', () => {
          if (window.scrollY === 0) {
            if (navbar.style.backgroundColor === 'white') {
              navbar.style.backgroundColor = '';
            } else {
              navbar.style.backgroundColor = 'white';
            }
          }
        });
      }

      // Reset background color when scrolling
      window.addEventListener('scroll', () => {
        if (window.scrollY > 0) {
          navbar.style.backgroundColor = '';
        }
      });

      //Update Menu Text
      function updateMenuText() {
        const menuButton = document.querySelector('.menu-button');
        const menuText = document.getElementById('menu-text');

        if (menuButton.classList.contains('w--open')) {
          menuText.textContent = 'Close';
        } else {
          menuText.textContent = 'Menu';
        }
      }

      // Call the function initially to set the correct text
      updateMenuText();

      // Add click event listener with a 100ms delay
      document.querySelector('.menu-button').addEventListener('click', function() {
        setTimeout(updateMenuText, 100);
      });


      //-----------------Legal Pages Index Interaction-------------------//


      $(document).ready(function() {
        let lastChecked = null; // Store the last checked radio button

        $('input[type="radio"][name="legal-index"]').on("click", function() {
          // or a more specific selector if needed

          if (this === lastChecked) {
            this.checked = false; // Uncheck the radio button
            lastChecked = null; // Clear the last checked variable
          } else {
            lastChecked = this; // Update the last checked radio button
          }
        });
      });

      // Wait for DOM to be ready
      $(document).ready(function() {
        // Function to update text based on checkbox state
        function updateIndexText() {
          // Only run when screen width is below 992px
          if ($(window).width() < 992) {
            if ($('input[name="mobile-index-dropdown"]').is(":checked")) {
              $("#index-mobile-text").text("Close Contents:");
            } else {
              $("#index-mobile-text").text("View Contents:");
            }
          }
        }

        // Run on page load to set initial state
        updateIndexText();

        // Add change event listener to the checkbox
        $('input[name="mobile-index-dropdown"]').on("change", function() {
          updateIndexText();
        });

        // Re-check on window resize with debounce
        let resizeTimer;
        $(window).on("resize", function() {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(updateIndexText, 250);
        });
      });



      document.addEventListener("DOMContentLoaded", function() {
        // Extract the path segment after "/legal/" and before the next "/"
        const currentUrl = window.location.pathname;
        const match = currentUrl.match(/\/legal\/([^/]+)/);

        if (match && match[1]) {
          const targetName = match[1];

          // Find the radio button with the matching name
          const radioButtons = document.querySelectorAll('input[type="radio"]');

          // Loop through all radio buttons
          radioButtons.forEach((radio) => {
            // If the name attribute matches the extracted path segment
            if (radio.id === targetName) {
              radio.checked = true;

              // Optionally dispatch a change event if your page relies on this
              const event = new Event("change", {
                bubbles: true
              });
              radio.dispatchEvent(event);


            }
          });
        } else {
          console.log('Page not found');
        }
      });


      //-----------------Cookie Preferences-------------------//
      $(document).ready(function() {
        const cookiePreferences = document.querySelector('#cookie-preferences');

        if (cookiePreferences) {
          cookiePreferences.addEventListener('click', () => {
            truste.eu.clickListener();
          });
        }
      });
    </script>

    <!-- Passing cleaned url to Hubspot form -->
    <script>
      (function() {
        // Get and clean the URL
        function getCleanUrl() {
          let url = window.location.href;
          url = url.replace(/^https?:\/\//, '');
          url = url.replace(/^www\./, '');
          url = url.split('?')[0];
          url = url.split('#')[0];
          return url;
        }

        const cleanUrl = getCleanUrl();
        console.log('Clean URL prepared:', cleanUrl);

        // Store the URL in a data attribute on the form container
        // so HubSpot can pick it up
        document.addEventListener('DOMContentLoaded', function() {
          const formContainers = document.querySelectorAll('.hs-form-frame');
          formContainers.forEach(function(container) {
            // Add it as a data attribute that query strings can use
            const formId = container.getAttribute('data-form-id');
            const portalId = container.getAttribute('data-portal-id');

            console.log('Found form container for form:', formId);

            // Store in data attribute
            container.setAttribute('data-last-form-page-url', cleanUrl);
          });
        });

        // Intercept iframe creation and modify src before it's set
        const observer = new MutationObserver(function(mutations) {
          mutations.forEach(function(mutation) {
            mutation.addedNodes.forEach(function(node) {
              if (node.tagName === 'IFRAME' && node.src && node.src.includes('hsforms.net')) {
                console.log('Intercepted iframe creation');

                // Only modify if not already modified
                if (!node.src.includes('last_form_page_url=')) {
                  const encodedUrl = encodeURIComponent(cleanUrl);
                  const separator = node.src.includes('?') ? '&' : '?';
                  node.src = node.src + separator + 'last_form_page_url=' + encodedUrl;

                  console.log('Modified iframe src with URL parameter');
                }
              }
            });
          });
        });

        // Start observing
        observer.observe(document.body, {
          childList: true,
          subtree: true
        });

        console.log('URL capture script initialized');
      })();
    </script>
  </body>
</html>