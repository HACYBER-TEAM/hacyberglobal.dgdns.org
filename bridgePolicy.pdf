            <div class="footer-bottom-right"><a href="/legal/overview" class="text-size-title typeface-diatype-regular text-color-dark-grey">Legal</a><a href="/legal/eea-privacy-policy/this-document" class="text-size-title typeface-diatype-regular text-color-dark-grey">Privacy</a>
              <div class="text-size-title typeface-diatype-regular text-color-dark-grey">© Bridge <span id="current-year">2024</span></div>
            </div>
          </div>
        </div>
        <div class="footer-white-fade"></div>
        <div class="footer-bg">
          <div class="footer-embed w-embed w-iframe">
            <div data-video-id="53727" style="width: 100%; height: 100%;overflow: hidden;">

              <iframe width="100%" height="100%" src="https://app.vidzflow.com/v/CoTyLdyCMy?dq=1080&ap=true&muted=true&loop=true&ctp=false&bv=true&piv=false&playsinline=true&bc=%234E5FFD&controls=false" title="Bridge Header Loop 1080p Laravel" style="overflow: hidden;" frameborder="0" scrolling="no" allow="fullscreen"></iframe>
            </div>
          </div>
          <div class="div-block-7"></div>
        </div>
