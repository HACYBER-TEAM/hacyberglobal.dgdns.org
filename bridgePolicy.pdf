        <style>
          /* Hide scrollbar for Chrome, Safari and Opera */
          .legal-index-title-wrapper::-webkit-scrollbar {
            display: none;
          }

          /* Hide scrollbar for IE, Edge and Firefox */
          .legal-index-title-wrapper {
            -ms-overflow-style: none;
            /* IE and Edge */
            scrollbar-width: none;
            /* Firefox */
          }

          .legal-block .text-size-large a {
            text-decoration: underline;
            color: #4d4d4d;
          }

          .legal-tab:has(.legal-tab-radio:checked) .legal-tab-content {
            grid-template-rows: 1fr;
          }

          .legal-tab:has(.legal-tab-radio:checked) .legal-index-square {
            background-color: #40CFFF;
            ;
          }

          .legal-tab:has(.legal-tab-radio:checked) .legal-index-tab-title-icon {
            transform: rotate(180deg);
          }

          .legal-mobile-content-tab:has(.legal-tab-checkbox:checked) .legal-index-component {
            grid-template-rows: 1fr;
          }

          .legal-mobile-content-tab:has(.legal-tab-checkbox:checked) .legal-index-component-icon {
            transform: rotate(180deg);
          }
        </style>
