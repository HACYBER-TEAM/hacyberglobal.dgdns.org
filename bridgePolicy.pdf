                <div data-is-ix2-target="1" class="nav-lottie" data-w-id="7dbf6386-0587-3348-f769-2342f7de7e3c" data-animation-type="lottie" data-src="https://cdn.prod.website-files.com/66c78bffc753432b33c4f61a/66c78bffc753432b33c4f672_nav%20menu%20lottie.json" data-loop="0" data-direction="1" data-autoplay="0" data-renderer="svg" data-default-duration="1" data-duration="0" data-ix2-initial-state="0"></div>
              </div>
